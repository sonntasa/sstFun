Package: sstFun
Version: 1.0.0
Date: 2026-10-28
Title: Estimating Stop Signal Reaction Times and Stop Signal Delay
Authors@R: c(
    person(given = "Samuel", family = "Sonntag", email="samuel.sonntag@uni-tuebingen.de", role = c("cre", "aut"), comment = c(ORCID = "0009-0006-7270-7242")),
